/* \x86_64\linker.ld - скрипт компоновки ядра Осирис.
   W^X-версия (v1.1.6+): раздельные права сегментов ELF.

   Ядро грузится stage2 на физ. 0x20000 (сегмент 0x2000, LBA 16),
   и GDT теперь ПЛОСКАЯ (база 0), поэтому линейный адрес = физический.
   Адрес компоновки обязан совпадать с адресом загрузки.

   PHDRS даёт три LOAD-сегмента: текст R-X, константы R--, данные RW-.
   Это правит предупреждение binutils
     'kernel.elf has a LOAD segment with RWX permissions'
   (оно появлялось потому, что .text+.rodata+.data сливались в один
   сегмент с флагами RWX), и заранее готовит карту для NX-битов
   страничной адресации: достаточно будет разрешить страницам те же
   права, что у сегментов. Раскладка секций ПОРЯДКОВА не менялась:
   .rodata раньше была 'сиротой' (ld клал её сразу после .text) -
   теперь она явная, адреса те же, kernel.bin от objcopy не меняется.
   Когда дойдёт до страниц с выравниванием 4K - добавить ALIGN(4K)
   перед .rodata/.data (размер kernel.bin вырастет на прокладки). */
OUTPUT_FORMAT(elf32-i386)
ENTRY(_start)

PHDRS
{
    text   PT_LOAD FLAGS(5);   /* R-X: код */
    rodata PT_LOAD FLAGS(4);   /* R--: константы и строки */
    data   PT_LOAD FLAGS(6);   /* RW-: данные + bss */
}

SECTIONS
{
    . = 0x20000;

    .text   : { *(.text*) }                    :text
    .rodata : { *(.rodata*) }                  :rodata

    .data   : { *(.data*) }                    :data
    .bss    : { *(COMMON) *(.bss*) }           :data

    /DISCARD/ : { *(.eh_frame) *(.comment) *(.note*) }
}
