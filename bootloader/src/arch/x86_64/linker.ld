/* \x86_64\linker.ld - скрипт для компоновки ядра */
/* Ядро грузится stage2 на физ. 0x20000 (сегмент 0x2000, LBA 15),
   и GDT теперь ПЛОСКАЯ (база 0), поэтому линейный адрес = физический.
   Адрес компоновки обязан совпадать с адресом загрузки. */
ENTRY(_start)

SECTIONS {
    . = 0x20000;
    .text : { *(.text) }
    .data : { *(.data) }
    .bss : {
        *(COMMON)
        *(.bss)
     }
}
